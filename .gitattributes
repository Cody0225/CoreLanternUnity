# Keep source and Unity text assets stable across Windows tooling.
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asmdef text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ttf binary
